# Canonical site URL used for metadata, Open Graph, sitemap and JSON-LD.
# Leave unset on Vercel to use the project's production URL automatically.
# Use https://ashugraphy.in only once that domain is registered and pointed at Vercel.
NEXT_PUBLIC_SITE_URL=https://ashugraphy.in

# Studio WhatsApp number in international format, digits only, no "+" (example format: 91XXXXXXXXXX).
# Leave empty to open WhatsApp in share mode with the composed message (the user picks the chat).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# true keeps the demo out of search indexes (noindex, nofollow). Set to false at launch.
NEXT_PUBLIC_DEMO_MODE=true

# Optional. Photograph for the link preview card, relative to the project root.
# Defaults to images/hero-desktop.webp (the card stays typographic while that is a placeholder).
# OG_IMAGE_SOURCE=images/hero-desktop.webp
